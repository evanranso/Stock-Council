# Copy to .env and fill in. Never commit .env.

# Required: https://console.anthropic.com
ANTHROPIC_API_KEY=

# Free keys, strongly recommended:
# https://finnhub.io  (news, insider trades, peers, analyst trends)
FINNHUB_API_KEY=
# https://fred.stlouisfed.org/docs/api/api_key.html  (economy)
FRED_API_KEY=

# SEC asks every client to identify itself with a name and contact email.
SEC_USER_AGENT="StockCouncil your-email@example.com"

# Model + cost controls
CLAUDE_MODEL=claude-opus-5-5
SPECIALIST_EFFORT=medium
DEBATE_EFFORT=high
MAX_PARALLEL_AGENTS=6

# Web
ALLOWED_ORIGINS=http://localhost:3000
RATE_LIMIT_PER_HOUR=10
CACHE_TTL_HOURS=12
