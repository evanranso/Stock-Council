# Copy to .env and fill in. Never commit .env.

# Required: https://console.anthropic.com
ANTHROPIC_API_KEY=

# Free keys, strongly recommended:
# https://finnhub.io  (news, insider trades, peers, analyst trends)
FINNHUB_API_KEY=
# https://fred.stlouisfed.org/docs/api/api_key.html  (economy)
FRED_API_KEY=

# SEC asks every client to identify itself with a name and contact email.
SEC_USER_AGENT="StockCouncil your-email@example.com"

# Model + cost controls
CLAUDE_MODEL=claude-opus-5-5
SPECIALIST_EFFORT=medium
DEBATE_EFFORT=high
MAX_PARALLEL_AGENTS=6

# Web
ALLOWED_ORIGINS=http://localhost:3000
RATE_LIMIT_PER_HOUR=10
CACHE_TTL_HOURS=12
MAX_RUNS_PER_DAY=40
# Set true when running behind a hosting proxy (Render/Railway/Fly)
TRUST_PROXY=false
# Optional regex for extra allowed origins, e.g. Cloudflare preview deploys
ALLOWED_ORIGIN_REGEX=

# Database. Empty = local SQLite at CACHE_PATH. Production: Supabase Postgres connection string
# (Supabase → Connect → Transaction pooler). Secret: set it only in Render, never commit it.
DATABASE_URL=

# Accounts (Supabase Auth). Setting SUPABASE_URL turns accounts on (ACCESS_MODE defaults to "accounts").
SUPABASE_URL=
# Only for old projects that still sign tokens with the legacy HS256 JWT secret. Leave empty otherwise.
SUPABASE_JWT_SECRET=
# Free credits for each new verified account (4 = 2 Standard analyses), and a daily cap on how many
# new accounts get them (protects your bill from mass sign-ups).
FREE_CREDITS=4
FREE_SIGNUPS_PER_DAY=50
# Comma-separated emails that can open /admin while signed in
ADMIN_EMAILS=

# Access control: "accounts" (sign in; credits per account), "open" (anyone, rate-limited),
# or "invite" (fresh analyses need an invite code with credits)
ACCESS_MODE=
# Credits on a new invite code. With accounts, a code is redeemed into an account for bonus credits.
DEFAULT_INVITE_CREDITS=6
# Credits charged per fresh analysis at each depth
CREDITS_QUICK=1
CREDITS_STANDARD=2
CREDITS_DEEP=3
# Optional long random string that also unlocks /admin (besides ADMIN_EMAILS). Leave empty to disable.
ADMIN_KEY=
